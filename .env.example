# ==============================================================================
# BIWASE CRM GEO-PLANNER & PLAYWRIGHT AI AUTOMATION - CONFIGURATION FILE
# Hướng dẫn: Đổi tên file này thành .env (hoặc copy sang .env) và điền các giá trị bên dưới
# ==============================================================================

# 1. Khóa Google Gemini API (Dùng cho Gemini 2.0 Flash phân tích ảnh Sổ Đỏ / CCCD)
# Lấy miễn phí tại: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# 2. Cổng đăng nhập CRM BIWASE (Dành cho Playwright Automation Bot)
CRM_BASE_URL="https://crm.biwase.com.vn"
CRM_USERNAME="your_username_here"
CRM_PASSWORD="your_password_here"

# 3. Kinh tuyến trục trắc địa địa phương (VN-2000 Proj4)
# Mặc định: 105.75 (Tương đương 105°45' cho tỉnh Bình Dương / TP. Bến Cát / Thuận An / Dĩ An)
# TP. Hồ Chí Minh: 105.75 (105°45')
# Đồng Nai: 107.75 (107°45')
PROJ_KINH_TUYEN_TRUC=105.75

# 4. Cổng chạy máy chủ Web Node.js Local (Mặc định 3000)
PORT=3000

# 5. Cấu hình Playwright Bot (Chạy hiển thị trình duyệt thật để kiểm soát)
PLAYWRIGHT_HEADLESS=false
PLAYWRIGHT_SLOW_MO=300

# 6. URL ứng dụng khi chạy local
APP_URL="http://localhost:3000"
